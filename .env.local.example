# Copy to .env.local and fill in your values
# Never commit .env.local to git

# Helius or QuickNode devnet RPC endpoint
NEXT_PUBLIC_SOLANA_RPC=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Populated after `anchor deploy --provider.cluster devnet`
NEXT_PUBLIC_WORKER_REGISTRY_PROGRAM_ID=
NEXT_PUBLIC_PAYROLL_VAULT_PROGRAM_ID=
NEXT_PUBLIC_ESCROW_MANAGER_PROGRAM_ID=
NEXT_PUBLIC_COMPLIANCE_LOG_PROGRAM_ID=

# Fireblocks sandbox credentials
FIREBLOCKS_API_KEY=
FIREBLOCKS_SECRET_KEY_PATH=./fireblocks_secret.key

# SIX BFI FX data feed
SIX_API_KEY=

# KYC provider (mocked on devnet — any string works)
KYC_PROVIDER_KEY=devnet-mock
